{
  "info": {
    "name": "inventory-service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8083/api"
    },
    {
      "key": "apiKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Internal-Api-Key",
            "value": "{{apiKey}}",
            "disabled": true
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        }
      }
    },
    {
      "name": "1 Create item",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Internal-Api-Key",
            "value": "{{apiKey}}",
            "disabled": true
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/inventory/items",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "inventory",
            "items"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": 1,\n  \"quantity\": 100,\n  \"reorderLevel\": 10\n}"
        }
      }
    },
    {
      "name": "2 List items",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Internal-Api-Key",
            "value": "{{apiKey}}",
            "disabled": true
          }
