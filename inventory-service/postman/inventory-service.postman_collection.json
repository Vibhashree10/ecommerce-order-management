        "url": {
          "raw": "{{baseUrl}}/inventory/items/1/movements?page=0&size=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "inventory",
            "items",
            "1",
            "movements"
          ],
          "query": [
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "20"
            }
          ]
        }
