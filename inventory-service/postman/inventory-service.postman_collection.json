          "raw": "{{baseUrl}}/inventory/items?page=0&size=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "inventory",
            "items"
          ],
          "query": [
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "20"
            }
          ]
        }
      }
    },
    {
      "name": "3 Low stock",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Internal-Api-Key",
            "value": "{{apiKey}}",
            "disabled": true
