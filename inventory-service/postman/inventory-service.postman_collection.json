            "{{baseUrl}}"
          ],
          "path": [
            "inventory",
            "items",
            "1"
          ]
        }
      }
    },
    {
      "name": "5 Availability",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Internal-Api-Key",
            "value": "{{apiKey}}",
            "disabled": true
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/inventory/items/1/availability?quantity=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "inventory",
            "items",
            "1",
            "availability"
          ],
          "query": [
