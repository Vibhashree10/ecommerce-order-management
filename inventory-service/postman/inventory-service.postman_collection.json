              "key": "quantity",
              "value": "5"
            }
          ]
        }
      }
    },
    {
      "name": "6a Adjust +",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Internal-Api-Key",
            "value": "{{apiKey}}",
            "disabled": true
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/inventory/items/1/stock",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "inventory",
            "items",
            "1",
            "stock"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"delta\": 50,\n  \"reason\": \"Goods received from supplier\"\n}"
        }
      }
    },
    {
      "name": "6b Adjust -",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Internal-Api-Key",
            "value": "{{apiKey}}",
            "disabled": true
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/inventory/items/1/stock",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "inventory",
            "items",
            "1",
            "stock"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"delta\": -3,\n  \"reason\": \"Damaged in warehouse\"\n}"
        }
      }
    },
    {
      "name": "7 Movements",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Internal-Api-Key",
            "value": "{{apiKey}}",
            "disabled": true
