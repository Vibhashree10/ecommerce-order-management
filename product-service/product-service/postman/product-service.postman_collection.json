{
  "info": {
    "name": "product-service",
    "description": "baseUrl: http://localhost:8082/api | AWS direct: http://PRODUCT_ALB/api | via gateway: http://GATEWAY_ALB/api. Set 'token' (from auth-service Login) when the service or the gateway requires it. Items marked (verify) use paths taken from the README: confirm them in Swagger ({{baseUrl}}/swagger-ui.html) and fix the path if it differs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": "1"
    },
    {
      "key": "productId",
      "value": "1"
    },
    {
      "key": "sku",
      "value": "PM-SKU-001"
    }
  ],
  "item": [
    {
      "name": "Health (public)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/actuator/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Create category (query parameters)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/category?name=PM Electronics&description=Created from Postman&imageUrl=https://example.com/e.jpg",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json(); if (j.id) pm.collectionVariables.set('categoryId', j.id);",
                  "pm.test('created', () => pm.expect([200,201]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "List categories (paged) (verify)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/category?page=0&size=10",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Get category by id (verify)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/category/{{categoryId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Search categories by name (verify)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/category/search?name=Electronics",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Create product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/products",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"{{sku}}\",\n  \"name\": \"Postman Laptop\",\n  \"description\": \"Created from Postman\",\n  \"price\": 999.99,\n  \"quantity\": 10,\n  \"categoryId\": \"{{categoryId}}\",\n  \"manufacturer\": \"TechCorp\",\n  \"imageUrl\": \"https://example.com/p.jpg\"\n}"
            },
            "description": "Change 'sku' for each new product: SKUs are unique."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json(); if (j.id) pm.collectionVariables.set('productId', j.id);",
                  "pm.test('created', () => pm.expect([200,201]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "List products (paged)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products?page=0&size=10",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with content', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.have.property('content'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get product by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products/{{productId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get unknown product (expect 404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products/999999",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get product by SKU (verify)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products/sku/{{sku}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Search products by name (verify)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products/search?name=Laptop",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Products in a category (verify)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products/category/{{categoryId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Low-stock report (verify)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products/low-stock?threshold=5",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Update product (verify)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/products/{{productId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"{{sku}}\",\n  \"name\": \"Postman Laptop v2\",\n  \"description\": \"Updated\",\n  \"price\": 1099.99,\n  \"quantity\": 10,\n  \"categoryId\": \"{{categoryId}}\",\n  \"manufacturer\": \"TechCorp\",\n  \"imageUrl\": \"https://example.com/p.jpg\"\n}"
            }
          }
        },
        {
          "name": "Deactivate product (verify)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/products/{{productId}}/deactivate",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Activate product (verify)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/products/{{productId}}/activate",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Delete product (verify)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/products/{{productId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}