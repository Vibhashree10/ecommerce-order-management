# Example values for the variables the deploy scripts read.
# Copy these lines into your Git Bash session (or into a private file named deploy.env, which is git-ignored,
# then run: set -a; source deploy.env; set +a).
# NEVER commit real passwords. Replace every value in angle-free placeholders below with your own.

export AWS_PROFILE=ecommerce-dev
export AWS_REGION=us-east-1

# One ECS cluster per service in this project (see docs/DEPLOYMENT.md). List yours with:  aws ecs list-clusters
export CLUSTER_NAME=ecommerce-inventory-service-cluster
export ALLOW_NEW_CLUSTER=1            # only for the FIRST deploy of a service; the script refuses to create clusters otherwise

# Shared RDS PostgreSQL instance (host name only, no port). Find it with:
#   aws rds describe-db-instances --query "DBInstances[].[DBInstanceIdentifier,Endpoint.Address]" --output table
export RDS_ENDPOINT=YOUR-DB-INSTANCE.xxxxxxxx.us-east-1.rds.amazonaws.com
export DB_USERNAME=YOUR_RDS_MASTER_USER      # must be the RDS MASTER user
export DB_PASSWORD=YOUR_RDS_MASTER_PASSWORD
export CREATE_DB=1                    # 1 = create the service database on the first deploy; 0 afterwards

# Optional
# export EVENT_PUBLISHER=kafka        # default: logging (no Kafka needed)
# export KAFKA_BOOTSTRAP=172.31.10.20:9092     # PRIVATE ip of the Kafka EC2 instance (bash kafka-ec2.sh up)
# export ENABLE_PRODUCT_VALIDATION=1  # inventory-service only: verify the product exists before creating stock
# export SKIP_BUILD=1 IMAGE_TAG=20261102-181503   # redeploy/rollback an image that is already in ECR
