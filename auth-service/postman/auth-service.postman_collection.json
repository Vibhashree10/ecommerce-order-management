{
  "info": {
    "name": "auth-service",
    "description": "baseUrl: http://localhost:8081/api  |  AWS direct: http://AUTH_ALB/api  |  via gateway: http://GATEWAY_ALB/api (same paths). Run 'Register' once, then 'Login' (it stores the token).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081/api"
    },
    {
      "key": "username",
      "value": "pmuser"
    },
    {
      "key": "email",
      "value": "pmuser@example.com"
    },
    {
      "key": "password",
      "value": "Passw0rd!"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health (public)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/actuator/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
            ]
          }
        }
      ]
    },
    {
      "name": "1 Register (201; 400/409 if the user exists)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('created or already exists', () => pm.expect([201,400,409]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "2 Login (stores token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j = pm.response.json();",
              "const t = j.accessToken || j.token;",
              "if (t) { pm.collectionVariables.set('token', t); }",
              "if (j.refreshToken) { pm.collectionVariables.set('refreshToken', j.refreshToken); }",
              "pm.test('login returned a token', () => pm.expect(t).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "2b Login with wrong password (expect 401)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"definitely-wrong\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('rejected', () => pm.expect([400,401]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "3 Register with empty body (expect 400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "4 User by id (needs token; id from the login response 'user.id')",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/users/1",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "description": "Path from UserController; confirm in Swagger: {{baseUrl}}/swagger-ui.html"
      }
    },
    {
      "name": "5 Call without token (expect 401 through the gateway)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/users/1",
        "auth": {
          "type": "noauth"
        },
        "description": "Direct to auth-service this may behave differently; through the gateway it must be 401."
      }
    }
  ]
}