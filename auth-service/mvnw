#!/bin/sh
# Maven Wrapper script for Unix/Linux

PRG="$0"
while [ -h "$PRG" ]; do
    ls=$(ls -ld "$PRG")
    link=$(expr "$ls" : '.*-> \(.*\)$')
    if expr "$link" : '/.*' > /dev/null; then
        PRG="$link"
    else
        PRG=$(dirname "$PRG")"/$link"
    fi
done
PRGDIR=$(dirname "$PRG")
MAVEN_HOME=$(cd "$PRGDIR/.." > /dev/null; pwd)

MAVEN_CMD_LINE_ARGS="$@"

exec "$MAVEN_HOME/bin/mvn" $MAVEN_CMD_LINE_ARGS
